// Firestore Security Rules for SEAMUNs
// Copy these into Firebase Console → Firestore Database → Rules, then Publish.
// Without these, Google sign-in can succeed but the app will show "insufficient permissions"
// when creating or reading the user profile.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: each authenticated user can read and write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Attendance: authenticated users can read/write (app uses doc ids like userId_confId)
    match /attendance/{docId} {
      allow read, write: if request.auth != null;
    }

    // Archive: anyone can read; create must set authorId to the signed-in user;
    // only the author can update or delete their document (authorId cannot change).
    match /archive/{docId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }
  }
}
